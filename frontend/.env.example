# Web3Forms: crea tu access key gratis en https://web3forms.com con tu correo.
# Es pública por diseño (solo permite ENVIAR al correo registrado), pero va en variables de
# entorno para poder rotarla sin tocar código. En Vercel: Settings → Environment Variables.
VITE_WEB3FORMS_KEY=

# Opcional: fuerza el canal de YouTube (si no, se resuelve desde el handle)
# YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YT_HANDLE=@DavidCevaZam
